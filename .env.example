# ==============================================================================
# ConversionBridge Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your production '.env' with active secrets to version control.
# ==============================================================================

# General Service Settings
PROJECT_NAME=ConversionBridge
ENVIRONMENT=development
DEBUG=false
PORT=8080

# Security & Ingestion Protection
# When REQUIRE_API_KEY is true, clients must supply X-API-Key or Authorization Bearer header
REQUIRE_API_KEY=false
API_KEY=your-first-party-api-key-here
RATE_LIMIT_REQUESTS_PER_MINUTE=120
MAX_PAYLOAD_SIZE_BYTES=524288

# Event Deduplication & State Storage
# Options: 'memory' (for single-process/local dev) or 'firestore' (production)
STORAGE_BACKEND=memory
FIRESTORE_COLLECTION=conversionbridge_events
DEDUPLICATION_WINDOW_HOURS=48

# Privacy & Consent Policy
# When true, events with missing or ambiguous consent signals fail closed (blocked)
DEFAULT_CONSENT_FAIL_CLOSED=true

# ------------------------------------------------------------------------------
# Meta Conversions API (CAPI) Integration
# ------------------------------------------------------------------------------
META_ENABLED=false
META_PIXEL_ID=123456789012345
META_ACCESS_TOKEN=EAAG_your_system_user_access_token_here
META_API_VERSION=v20.0
# Optional: test_event_code from Meta Events Manager > Test Events tab
META_TEST_EVENT_CODE=
META_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# Google Analytics 4 (GA4) Measurement Protocol Integration
# ------------------------------------------------------------------------------
GA4_ENABLED=false
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your_measurement_protocol_api_secret_here
# When true, routes events to /debug/mp/collect to validate in GA4 DebugView
GA4_DEBUG_MODE=false
GA4_TIMEOUT_SECONDS=10.0
